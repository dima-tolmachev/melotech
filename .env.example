# OpenAI — used for platform content generation + embeddings
OPENAI_API_KEY=sk-...
# Optional: override the generation model (default: gpt-4o-mini)
OPENAI_GENERATION_MODEL=gpt-4o-mini

# Supabase (server-side access via service role for inserts/queries)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Pipeline tuning
RATE_LIMIT_PER_MINUTE=3
